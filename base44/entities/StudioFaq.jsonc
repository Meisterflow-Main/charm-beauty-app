{
  "name": "StudioFaq",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Frage, wie sie auf der Website erscheint"
    },
    "description": {
      "type": "string",
      "description": "Kurzfassung der Antwort f\u00fcr \u00dcbersichten und Suchmaschinen"
    },
    "answer": {
      "type": "string",
      "description": "Ausf\u00fchrliche Antwort"
    },
    "category": {
      "type": "string",
      "enum": [
        "Termine",
        "Behandlungen",
        "Ablauf",
        "Zahlung",
        "Anreise"
      ],
      "enumColors": [
        "blue",
        "pink",
        "purple",
        "green",
        "gray"
      ],
      "description": "Themengebiet der Frage"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Reihenfolge in der Anzeige"
    }
  },
  "required": [
    "title",
    "answer"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}